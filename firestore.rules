rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== مين داخل =====
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isBoss() { return signedIn() && email() == 'x.omar00@gmail.com'; }
    function profile() { return get(/databases/$(database)/documents/users/$(email())).data; }
    function member() { return isBoss() || (signedIn() && exists(/databases/$(database)/documents/users/$(email()))); }
    function role() { return isBoss() ? 'owner' : profile().role; }
    function owner() { return member() && role() == 'owner'; }
    function staff() { return member() && role() in ['owner', 'staff']; }
    function driver() { return member() && role() == 'driver'; }

    // الفريق: المالك بس يضيف ويشيل، وكل واحد يقرا بياناته
    match /users/{e} {
      allow read: if owner() || (signedIn() && email() == e);
      allow write: if owner();
    }

    // الإعدادات: الكل يقرا، المالك بس يعدّل
    match /settings/{id} {
      allow read: if member();
      allow write: if owner();
    }

    // المنتجات والعروض: الكل يقرا، المالك بس يعدّل
    match /products/{id} { allow read: if member(); allow write: if owner(); }
    match /offers/{id}   { allow read: if member(); allow write: if owner(); }

    // الأوردرات: الموظف يسجل ويعدّل، المندوب يعلّم "اتسلم" بس، المالك بس يمسح
    match /orders/{id} {
      allow read: if member();
      allow create: if staff();
      allow update: if staff()
        || (driver() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'deliveredAt', 'deliveredBy', 'updatedAt', '_by', '_at']));
      allow delete: if owner();
    }

    // المصاريف: المالك بس، والموظف يسجل ويشوف الهالك بس
    match /expenses/{id} {
      allow read: if owner() || (staff() && resource.data.cat == 'waste');
      allow create: if owner() || (staff() && request.resource.data.cat == 'waste');
      allow update, delete: if owner();
    }

    // المخزن: الموظف يسجل، المالك بس يمسح
    match /batches/{id}  { allow read: if member(); allow create, update: if staff(); allow delete: if owner(); }
    match /adjust/{id}   { allow read: if member(); allow create, update: if staff(); allow delete: if owner(); }
    match /supplies/{id} { allow read: if member(); allow create, update: if staff(); allow delete: if owner(); }

    // الموقع: أي حد يقرا (عشان الزباين يشوفوه)، المالك بس يعدّل
    match /site/{id}       { allow read: if true; allow write: if owner(); }
    match /siteImages/{id} { allow read: if true; allow write: if owner(); }

    // العملاء: تصنيف وملاحظات — الموظف والمالك
    match /customers/{id} { allow read, create, update: if staff(); allow delete: if owner(); }

    // طلبات الموقع: أي زبون يبعت طلب (بحدود)، والفريق بس يقرا ويمسح
    match /inbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'area', 'address', 'lines', 'total', 'at', 'ddate', 'dtime', 'dto', 'fee', 'pay', 'proof', 'tk'])
        && request.resource.data.lines is list && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 20
        && request.resource.data.get('area', '') is string && request.resource.data.get('area', '').size() <= 40
        && request.resource.data.get('address', '') is string && request.resource.data.get('address', '').size() <= 150
        && request.resource.data.get('ddate', '') is string && request.resource.data.get('ddate', '').size() <= 10
        && request.resource.data.get('dtime', '') is string && request.resource.data.get('dtime', '').size() <= 5
        && request.resource.data.get('dto', '') is string && request.resource.data.get('dto', '').size() <= 5
        && request.resource.data.get('fee', 0) is number
        && request.resource.data.get('pay', 'cash') in ['cash', 'insta', 'wallet']
        && request.resource.data.get('proof', '') is string && request.resource.data.get('proof', '').size() <= 400000
        && request.resource.data.get('tk', '') is string && request.resource.data.get('tk', '').size() <= 24;
      allow read, update, delete: if staff();
    }

    // تتبع الطلب: الزبون معاه كود سري يقرا بيه حالة طلبه بس، ومحدش يقدر يعرض الكل
    match /track/{id} { allow get: if true; allow list: if false; allow write: if staff(); }

    // نبّهني لما يرجع: أي زبون يسيب رقمه، والفريق بس يقرا ويمسح
    match /notify/{id} {
      allow create: if request.resource.data.keys().hasOnly(['pid', 'pname', 'name', 'phone', 'at'])
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 60
        && request.resource.data.get('pname', '') is string && request.resource.data.get('pname', '').size() <= 80
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 20
        && request.resource.data.at is number;
      allow read, update, delete: if staff();
    }

    // صور تحويلات الدفع: الفريق بس
    match /proofs/{id} { allow read, write: if staff(); }
  }
}
